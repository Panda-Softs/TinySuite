{
  "name": "tinysuite-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Build scripts for standalone Tiny* distributions and offline demos",
  "scripts": {
    "build": "node scripts/build-dist.cjs",
    "build:check": "node scripts/build-dist.cjs --check",
    "vendor": "node scripts/vendor.cjs",
    "vendor:check": "node scripts/vendor.cjs --check",
    "check:demos": "node scripts/check-demos.cjs",
    "verify": "npm run build:check && npm run vendor:check && npm run check:demos",
    "check:demos:without-vendor": "node scripts/check-demos.cjs --allow-missing-vendor"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "cssnano": "7.1.1",
    "postcss": "8.5.15",
    "sass": "^1.107.1",
    "terser": "5.48.0"
  }
}
